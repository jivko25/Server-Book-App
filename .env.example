# Gemini (required for /api/summary)
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_OUTPUT_TOKENS=512
MAX_CHAPTER_CHARS=12000
TEMPERATURE=0

# CORS — comma-separated origins, or * for all
ALLOWED_ORIGINS=*

# Rulit catalog proxy
RULIT_BASE_URL=https://www.rulit.me
RULIT_CACHE_TTL_SECONDS=1800
RULIT_RATE_LIMIT_PER_MINUTE=30
RULIT_REQUEST_TIMEOUT_SECONDS=10

# Supabase (RAG pgvector) — backend uses secret key only
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Publishable key is for mobile/client only (Phase 5+), not needed on backend yet
# SUPABASE_PUBLISHABLE_KEY=
